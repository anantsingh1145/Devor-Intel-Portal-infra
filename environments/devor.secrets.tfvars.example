# Copy this file to devor.secrets.tfvars (gitignored) and fill in real values
# for local runs. Apply with both var files:
#   terraform apply -var-file=environments/devor.tfvars -var-file=environments/devor.secrets.tfvars
#
# In CI, this same map is supplied via the TF_VAR_secrets environment
# variable (JSON-encoded), sourced from a GitHub secret — see
# .github/workflows/deploy-infra.yaml. Keep both in sync when you add a key.
secrets = {
  ANTHROPIC_API_KEY = "sk-ant-..." # required (backend.py / CrewAI agents)
  SERPER_API_KEY    = "..."        # required (backend.py web search)
  SMTP_PASSWORD     = "..."        # optional feature: weekly email digest
  WEBHOOK_URL       = "..."        # optional feature: Slack/Teams/Discord digest — treated as secret since these URLs embed an access token
}
